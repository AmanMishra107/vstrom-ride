# ============================================================
# V-Strom Ride OS — Environment Variables
# ============================================================
#
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
#
# ============================================================

# ---- Google Maps Platform ----
# Required for map rendering, Places autocomplete, and Directions.
# Create at: https://console.cloud.google.com/
# APIs to enable: Maps JavaScript API, Places API, Directions API
# Set HTTP referrer restrictions on the key for security.
VITE_GOOGLE_MAPS_API_KEY=

# ---- OpenWeatherMap ----
# Required for the Weather screen.
# Free tier available at: https://openweathermap.org/api
# One Call API 3.0 is recommended.
VITE_WEATHER_API_KEY=

# ---- Supabase (Optional — for cloud sync) ----
# Required only if you enable cloud authentication and sync.
# Create a project at: https://supabase.com/
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
